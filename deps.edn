{:paths ["src" "resources"]

 :deps {org.clojure/clojure {:mvn/version "1.12.6"}
        metosin/malli {:mvn/version "0.20.2"}
        org.clojure/data.json {:mvn/version "2.5.2"}
        io.github.hive-agi/hive-addon {:mvn/version "1.1.2"}
        io.github.hive-agi/hive-dsl {:mvn/version "0.5.34"}
        io.github.hive-agi/hive-system {:mvn/version "0.3.13"}}

 :aliases
 {:dev {:extra-paths ["dev" "test" "test/resources"]
        :extra-deps {org.clojure/test.check {:mvn/version "1.1.3"}}}

  :test {:extra-paths ["test" "test/resources"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                      org.clojure/test.check {:mvn/version "1.1.3"}}
         ;; :integration drives a real docker daemon.
         :main-opts ["-m" "cognitect.test-runner" "-e" ":integration"]
         :exec-fn cognitect.test-runner.api/test}

  :integration {:extra-paths ["test" "test/resources"]
                :extra-deps {io.github.cognitect-labs/test-runner
                             {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                             org.clojure/test.check {:mvn/version "1.1.3"}}
                :main-opts ["-m" "cognitect.test-runner" "-i" ":integration"]}

  :nrepl {:extra-paths ["dev" "test" "test/resources"]
          :extra-deps {org.clojure/test.check {:mvn/version "1.1.3"}
                       nrepl/nrepl {:mvn/version "1.7.0"}
                       cider/cider-nrepl {:mvn/version "0.62.2"}}
          :main-opts ["-m" "nrepl.cmdline" "--middleware" "[cider.nrepl/cider-middleware]"]}

  :build {:deps {io.github.hive-agi/hive-build {:mvn/version "0.1.28"}}
          :jvm-opts ["-Xmx1g"]
          :ns-default hive-build.api}}}
